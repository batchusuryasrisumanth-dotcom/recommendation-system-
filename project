"""Ensemble recommender for a global e-commerce catalogue.

Run:   python recsys.py        ->  builds dashboard.html (open it in a browser)
Needs: pip install numpy pandas scikit-learn
Real data (optional): put online_retail_II.csv (UCI, transactions from many
countries) next to this file and run again. Otherwise a simulated world
marketplace is used.
"""
import json, os
import numpy as np, pandas as pd
from pathlib import Path
from sklearn.decomposition import TruncatedSVD
from sklearn.linear_model import LogisticRegression

rng = np.random.default_rng(7)
K = 10
REAL = "online_retail_II.csv"
COLS = ["Popularity", "ItemKNN", "SVD", "Category", "Stacked ensemble"]

# ---------------------------------------------------------------- data
ADJ = ["Linen", "Copper", "Walnut", "Ceramic", "Woven", "Enamel", "Cotton", "Brass", "Oak", "Glass",
       "Wool", "Bamboo", "Slate", "Painted", "Classic", "Vintage", "Folding", "Compact", "Handmade", "Striped"]
NOUNS = {"Kitchen": ["Pan", "Jug", "Whisk"], "Garden": ["Trowel", "Planter", "Hose"],
         "Stationery": ["Notebook", "Pen Set", "Planner"], "Toys": ["Puzzle", "Train Set", "Kite"],
         "Lighting": ["Lamp", "Lantern", "Fairy Lights"], "Bags": ["Tote", "Backpack", "Pouch"],
         "Home Decor": ["Vase", "Cushion", "Frame"], "Tea & Coffee": ["Teapot", "Grinder", "Mug"]}


def make_world(n_users=3000, n_items=400):
    countries = np.array(["India", "United Kingdom", "Germany", "Brazil", "Japan", "USA",
                          "France", "Nigeria", "Australia", "Mexico", "Canada", "Spain"])
    cats = np.array(list(NOUNS))
    icat = rng.integers(0, len(cats), n_items)
    names = [f"{rng.choice(ADJ)} {rng.choice(NOUNS[cats[c]])}" for c in icat]
    w = np.array([14, 10, 8, 8, 7, 12, 6, 5, 6, 5, 6, 5], float)
    uc = rng.choice(len(countries), n_users, p=w / w.sum())
    UL, IL = rng.normal(size=(n_users, 6)), rng.normal(size=(n_items, 6))
    CA = rng.normal(0, 1.1, (len(countries), len(cats)))      # each country likes different categories
    logpop = rng.normal(0, 0.8, n_items)
    rows = []
    for u in range(n_users):
        logit = 0.8 * IL @ UL[u] + CA[uc[u]][icat] + logpop
        p = np.exp(logit - logit.max()); p /= p.sum()
        for t, i in enumerate(rng.choice(n_items, 4 + rng.poisson(7), replace=False, p=p)):
            rows.append((u, i, t))
    return pd.DataFrame(rows, columns=["u", "i", "t"]), countries[uc], cats[icat], names


def load_real(path, max_items=1500, max_users=4000):
    d = pd.read_csv(path, encoding="latin1").rename(columns={"CustomerID": "Customer ID", "UnitPrice": "Price"})
    d = d.dropna(subset=["Customer ID", "Description"])
    d = d[(d.Quantity > 0) & (d.Price > 0)].copy()
    d["t"] = pd.to_datetime(d.InvoiceDate)
    d = d.sort_values("t").drop_duplicates(["Customer ID", "StockCode"])
    d = d[d.StockCode.isin(d.StockCode.value_counts().index[:max_items])]
    n = d.groupby("Customer ID").size()
    d = d[d["Customer ID"].isin(n[n >= 5].index[:max_users])]
    uid = {c: k for k, c in enumerate(d["Customer ID"].unique())}
    iid = {c: k for k, c in enumerate(d.StockCode.unique())}
    inter = pd.DataFrame({"u": d["Customer ID"].map(uid).values, "i": d.StockCode.map(iid).values, "t": d.t.values})
    desc = d.groupby("StockCode").Description.first().str.title()
    names = [desc[c] for c in iid]
    last = pd.Series(names).str.split().str[-1].str.upper()      # crude category = last word of description
    icat = np.where(last.isin(last.value_counts().index[:25]), last, "OTHER")
    ctry = d.groupby("Customer ID").Country.agg(lambda s: s.mode()[0])
    uc = pd.Series([ctry[c] for c in uid])
    return inter, np.where(uc.isin(uc.value_counts().index[:12]), uc, "Other"), icat, names


# ---------------------------------------------------------------- base models
def fit_scores(M, ucountry, icat):
    """Four different recommenders, each gives a (users x items) score matrix."""
    pop = np.zeros_like(M)
    for c in np.unique(ucountry):                       # 1. bestsellers inside the shopper's own country
        m = ucountry == c
        pop[m] = M[m].sum(0) + 0.1 * M.sum(0)
    nrm = np.sqrt((M ** 2).sum(0)) + 1e-9               # 2. item-item cosine similarity ("bought together")
    S = (M.T @ M) / np.outer(nrm, nrm); np.fill_diagonal(S, 0)
    knn = M @ S
    svd = TruncatedSVD(32, random_state=7)              # 3. latent taste factors
    mf = svd.fit_transform(M) @ svd.components_
    C = np.eye(icat.max() + 1, dtype=np.float32)[icat]  # 4. share of past purchases per category
    prof = M @ C; prof /= prof.sum(1, keepdims=True) + 1e-9
    cat = prof @ C.T + 0.001 * M.sum(0)
    return {"Popularity": pop, "ItemKNN": knn, "SVD": mf, "Category": cat}


def zs(S):
    return {k: ((v - v.mean(1, keepdims=True)) / (v.std(1, keepdims=True) + 1e-9)).astype(np.float32) for k, v in S.items()}


def candidates(S, blend, seen, topn=100):
    s = np.where(seen > 0, -np.inf, blend)
    cand = np.argsort(-s, 1)[:, :topn]
    r = np.arange(len(s))[:, None]
    return cand, np.stack([z[r, cand] for z in S.values()], -1)


def metrics(score, seen, target):
    s = np.where(seen > 0, -np.inf, score)
    t = s[np.arange(len(s)), target][:, None]
    rank = (s > t).sum(1) + ((s == t).sum(1) - 1) / 2   # ties split fairly
    hit = rank < K
    return hit, np.where(hit, 1 / np.log2(rank + 2), 0)


# ---------------------------------------------------------------- experiment
def main():
    real = os.path.exists(REAL)
    inter, ucountry, icat_s, names = load_real(REAL) if real else make_world()
    source = "Online Retail II (real transactions)" if real else "simulated world marketplace"
    inter = inter.sort_values(["u", "t"])
    users = inter.u.unique()
    inter["u"] = inter.u.map(pd.Series(range(len(users)), index=users))
    ucountry = np.asarray(ucountry)[users]
    _, icat = np.unique(icat_s, return_inverse=True)
    nU, nI = len(users), len(names)

    rk = inter.groupby("u").cumcount(ascending=False).values     # 0 = latest purchase

    def mat(mask):
        M = np.zeros((nU, nI), np.float32); s = inter[mask]; M[s.u.values, s.i.values] = 1; return M
    Tr, Va, Te = mat(rk >= 2), mat(rk == 1), mat(rk == 0)
    val_t, test_t = Va.argmax(1), Te.argmax(1)

    # Stage 1: learn how much to trust each model (fit on train, label = validation purchase)
    S = zs(fit_scores(Tr, ucountry, icat))
    cand, X = candidates(S, np.mean(list(S.values()), 0), Tr)
    clf = LogisticRegression(max_iter=1000).fit(X.reshape(-1, X.shape[-1]), (cand == val_t[:, None]).reshape(-1))

    # Stage 2: refit models on train+validation, test on the hidden latest purchase
    seen = Tr + Va
    S2 = zs(fit_scores(seen, ucountry, icat))
    blend = np.mean(list(S2.values()), 0)
    cand, X = candidates(S2, blend, seen)
    stacked = np.full((nU, nI), -np.inf, np.float32)
    np.put_along_axis(stacked, cand, clf.decision_function(X.reshape(-1, X.shape[-1])).reshape(cand.shape), 1)
    final = {**S2, "Equal-weight blend": blend, "Stacked ensemble": stacked}
    res = {k: metrics(v, seen, test_t) for k, v in final.items()}

    def table(groups):
        return [dict(name=n, n=int(m.sum()), vals=[round(float(res[c][0][m].mean()), 3) for c in COLS])
                for n, m in groups if m.sum() >= 5]
    ntr = Tr.sum(1)
    by_user = inter.groupby("u").i.apply(list)

    def top(k, u):
        s = np.where(seen[u] > 0, -np.inf, final[k][u])
        return [[names[j], int(j == test_t[u])] for j in np.argsort(-s)[:10]]
    demo = [dict(id=int(u), country=str(ucountry[u]), history=[names[j] for j in by_user[u][:-1][-6:]],
                 next=names[test_t[u]], recs={c: top(c, u) for c in COLS})
            for u in rng.choice(nU, 14, replace=False)]

    out = dict(source=source, n_users=nU, n_items=nI, n_countries=int(len(set(ucountry))), cols=COLS,
               models=[dict(name=k, hr=round(float(v[0].mean()), 4), ndcg=round(float(v[1].mean()), 4)) for k, v in res.items()],
               weights=[dict(name=k, w=round(float(w), 3)) for k, w in zip(S, clf.coef_[0])],
               by_country=table([(c, ucountry == c) for c in sorted(set(ucountry))]),
               by_segment=table([("Light buyers (4 or fewer past purchases)", ntr <= 4),
                                 ("Regular buyers (5 to 9)", (ntr >= 5) & (ntr <= 9)),
                                 ("Heavy buyers (10+)", ntr >= 10)]),
               demo=demo)
    for m in out["models"]:
        print(f"{m['name']:<20} HR@{K} {m['hr']:.3f}   NDCG@{K} {m['ndcg']:.3f}")
    html = HTML.replace("__DATA__", json.dumps(out).replace("</", "<\\/"))
    Path("dashboard.html").write_text(html, encoding="utf-8")
    print("Wrote dashboard.html - open it in your browser.")


