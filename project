</main><script>
const D=__DATA__,L={Popularity:"Bestsellers in their country",ItemKNN:"Bought together (item-KNN)",SVD:"Hidden taste (SVD)",Category:"Favourite categories","Equal-weight blend":"Equal-weight blend","Stacked ensemble":"Stacked ensemble"};
const $=s=>document.querySelector(s),f=x=>x.toFixed(3),esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const M=D.models,st=M[M.length-1],bs=M.slice(0,4).reduce((a,b)=>a.hr>b.hr?a:b),lift=(st.hr/bs.hr-1)*100;
$("#lede").textContent=`We hid each shopper's most recent purchase and asked four different recommenders, and then a combination of all four, to guess it. ${D.n_users.toLocaleString()} shoppers, ${D.n_items.toLocaleString()} products, ${D.n_countries} countries. Data: ${D.source}.`;
$("#stats").innerHTML=[[f(st.hr),"hit rate @10, stacked ensemble"],[(lift>=0?"+":"")+lift.toFixed(0)+"%","vs the best single model ("+L[bs.name]+")"],[D.n_users.toLocaleString(),"shoppers tested"]].map(x=>`<div><b>${x[0]}</b><span>${x[1]}</span></div>`).join("");
